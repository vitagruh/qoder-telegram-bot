[Unit]
Description=Qoder Telegram bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=qoderbot
Group=qoderbot
WorkingDirectory=/opt/qoder-telegram-bot
EnvironmentFile=-/opt/qoder-telegram-bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/qoder-telegram-bot/.venv/bin/python /opt/qoder-telegram-bot/bot.py
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=-/home/qoderbot/qoder-workspace -/home/qoderbot/.qoder -/home/qoderbot/.cache -/home/qoderbot/.config -/home/qoderbot/.local -/home/qoderbot/.npm
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
