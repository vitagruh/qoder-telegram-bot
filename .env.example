# Telegram
TELEGRAM_BOT_TOKEN=123456789:AA...your-token-from-BotFather
ALLOWED_USER_IDS=123456789

# Qoder (PAT: qoder.com/account/integrations)
QODER_PERSONAL_ACCESS_TOKEN=your-qoder-personal-access-token
# QODER_CONFIG_DIR=/home/qoderbot/.qoder

# Рабочая область: здесь создаются задачи и файлы
WORKSPACE_ROOT=/home/qoderbot/qoder-workspace

# Права: default | acceptEdits | plan | auto | dontAsk | bypassPermissions | yolo
PERMISSION_MODE=default

# Подтверждения: strict | balanced | trusted
# strict   — запись, Bash и сеть спрашивают, read-only чтение внутри задачи — нет
# balanced — запись внутри задачи и безопасный Bash без подтверждения;
#            сеть и прочие инструменты с подтверждением (рекомендуется)
# trusted  — Bash и сеть без подтверждения; файлы вне задачи всё равно запрещены.
#            ВНИМАНИЕ: с несколькими пользователями Bash может читать чужие каталоги.
APPROVAL_MODE=balanced
# Сетевые инструменты (WebFetch/WebSearch) без подтверждения вне режима trusted:
# 0 — спрашивать (по умолчанию), 1 — разрешать.
# AUTO_APPROVE_NETWORK=0

# Инструменты, выполняемые без подтверждения (через запятую).
# Файловые инструменты (Read/Write/Edit/Grep/Glob/LS/Notebook*), Bash и
# AskUserQuestion сюда добавить нельзя: они всегда проходят sandbox-политику
# и/или подтверждение. Пример безопасного не файлового инструмента: TodoWrite
ALLOWED_TOOLS=
# Инструменты, которые всегда требуют подтверждения, в любом APPROVAL_MODE.
# Имеют приоритет над trusted и «на сессию» не разрешаются.
# ALWAYS_CONFIRM_TOOLS=Write,Edit

# Админ-команды (/users, /tasks, /logs) в личном чате.
# Должно быть подмножеством ALLOWED_USER_IDS; пусто — команды выключены.
ADMIN_USER_IDS=

# Сколько задач может выполняться одновременно на весь бот.
MAX_CONCURRENT_TASKS=2

# Безопасные Bash-команды без подтверждения: off | readonly | dev
# readonly (по умолчанию) — только чтение и проверка git;
# dev — ещё тесты/сборка (выполняют код проекта, используйте осознанно);
# off — подтверждать любой Bash (кроме APPROVAL_MODE=trusted).
SAFE_BASH_MODE=readonly

# Лимиты
MAX_UPLOAD_MB=20
TASK_TIMEOUT_SEC=1200
APPROVAL_TIMEOUT_SEC=120
LOG_LEVEL=INFO
