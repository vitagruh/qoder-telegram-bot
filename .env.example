# Telegram
TELEGRAM_BOT_TOKEN=123456789:AA...your-token-from-BotFather
ALLOWED_USER_IDS=123456789

# Qoder (PAT: qoder.com/account/integrations)
QODER_PERSONAL_ACCESS_TOKEN=your-qoder-personal-access-token
# QODER_CONFIG_DIR=/home/qoderbot/.qoder

# Рабочая область: здесь создаются задачи и файлы
WORKSPACE_ROOT=/home/qoderbot/qoder-workspace

# Права: default | acceptEdits | plan | auto | dontAsk | bypassPermissions | yolo
PERMISSION_MODE=default
# Инструменты, выполняемые без подтверждения
ALLOWED_TOOLS=Read,Grep,Glob

# Лимиты
MAX_UPLOAD_MB=20
TASK_TIMEOUT_SEC=1200
APPROVAL_TIMEOUT_SEC=120
